# .env.example - Copy this to .env and fill in your values

# Stripe (test mode key from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# BigQuery (GCP service account credentials)
GOOGLE_APPLICATION_CREDENTIALS="keys/your-service-account.json"
BQ_DATASET="stripe_mrr"
BQ_PROJECT_ID="your-gcp-project-id"

# Generator options (adjust as needed)
NUM_CUSTOMERS=75
MAX_DAYS_BACK=180
STEP_DAYS=31
OVERDUE_PROB=0.10
CANCEL_PROB=0.20
SEED=43
